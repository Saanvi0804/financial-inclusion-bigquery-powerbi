# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Cloud Credentials & Secrets
*credentials*.json
*secret*.json
service_account*.json
gcp*.json
key*.json
.env
*.env

# Explicitly track Power BI project configuration files
!powerbi/**/*.json
!powerbi/**/*.pbip
!powerbi/**/*.pbir
!powerbi/**/*.pbism
!powerbi/**/*.bim

# Local database files
*.db
*.duckdb
*.duckdb.wal

# Virtual environments
venv/
.venv/
env/

# Logs & temporary files
*.log
*.tmp
.temp/

# OS generated files
.DS_Store
Thumbs.db

# Power BI local cache / user files
*.pbix.temp
