    "tables": [
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Dummy",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "6331184b-1c08-405a-8ca4-8d74b5ed8fd6",
            "sourceColumn": "Dummy"
          }
        ],
        "lineageTag": "measures-table-lineage",
        "measures": [
          {
            "name": "Active Loans Count",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(DISTINCTCOUNT(fact_loan_monthly[loan_key]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[outstanding_principal] > 0, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "#,##0",
            "lineageTag": "abf87fa2-d900-4f8a-92fa-50a076aeaa95"
          },
          {
            "name": "Total Outstanding Principal",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "2c75dcd7-cc2d-419e-83e9-88e8a7b9551e"
          },
          {
            "name": "Outstanding Principal (INR Cr)",
            "expression": "DIVIDE([Total Outstanding Principal], 10000000, 0)",
            "formatString": "\"\u20b9\"\\ #,##0.00\\ \"Cr\"",
            "lineageTag": "4655c001-ee7c-411d-a645-c6f2cc96d9bd"
          },
          {
            "name": "PAR 30 Principal",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] > 30, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "1074468b-0c51-4a41-ab6c-e67c971c6f7d"
          },
          {
            "name": "PAR 30 %",
            "expression": "DIVIDE([PAR 30 Principal], [Total Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "69918ecb-3f8d-49ae-a7a2-1cde68341379"
          },
          {
            "name": "PAR 90 Principal",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] > 90, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "2c3a45a2-dec8-4da5-8c91-223638727a6f"
          },
          {
            "name": "PAR 90 %",
            "expression": "DIVIDE([PAR 90 Principal], [Total Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "d323df43-236e-4644-b970-1a14b6a6392d"
          },
          {
            "name": "Current Principal",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] = 0, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "0e0d40d2-23e5-427e-afd8-1d4acfc55dd9"
          },
          {
            "name": "Delinquency DPD 1-30",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] >= 1, fact_loan_monthly[days_past_due] <= 30, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "b918397d-6361-4e80-8a0e-28ab55222769"
          },
          {
            "name": "Delinquency DPD 31-60",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] >= 31, fact_loan_monthly[days_past_due] <= 60, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "0973b742-413f-46ba-a819-3ee43d766097"
          },
          {
            "name": "Delinquency DPD 61-90",
            "expression": "VAR MaxSnapshotDate = CALCULATE(MAX(fact_loan_monthly[snapshot_date_key]), USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])) RETURN IF(ISBLANK(MaxSnapshotDate), BLANK(), CALCULATE(SUM(fact_loan_monthly[outstanding_principal]), fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate, fact_loan_monthly[days_past_due] >= 61, fact_loan_monthly[days_past_due] <= 90, USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "d36e989d-d3e3-4d85-8c04-fe0760109fc6"
          },
          {
            "name": "Scheduled Billing Due",
            "expression": "SUM(kpi_collection_efficiency[scheduled_amount_due])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "eeea3a71-4e9a-4b62-becf-b2b7c516f3c2"
          },
          {
            "name": "Current Period Collected",
            "expression": "SUM(kpi_collection_efficiency[current_period_collected])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "386c4ace-27b2-4767-bb7a-aaa270fdf8d5"
          },
          {
            "name": "Arrears Collected",
            "expression": "SUM(kpi_collection_efficiency[arrears_collected])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "52200bcc-29db-4acf-9b8b-b1335abe08c4"
          },
          {
            "name": "Advance Collected",
            "expression": "SUM(kpi_collection_efficiency[advance_collected])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "4a32eea3-b506-4b08-849a-fce65e00722f"
          },
          {
            "name": "Total Cash Collected",
            "expression": "SUM(kpi_collection_efficiency[total_amount_collected])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "df81c77b-5789-4b39-ac28-45d2a9bb47a0"
          },
          {
            "name": "Current Period Collection Efficiency %",
            "expression": "DIVIDE([Current Period Collected], [Scheduled Billing Due], 0)",
            "formatString": "0.00%",
            "lineageTag": "6f9148bc-bfb7-49d8-8f8d-bbe664de1c45"
          },
          {
            "name": "Total Collection Ratio %",
            "expression": "DIVIDE([Total Cash Collected], [Scheduled Billing Due], 0)",
            "formatString": "0.00%",
            "lineageTag": "c82db114-313c-4977-8ddb-09edfad485dc"
          },
          {
            "name": "Total Collections Value",
            "expression": "SUM(kpi_digital_collections[total_collection_value])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "cf735942-fe8e-4b94-a2be-a33bea65186b"
          },
          {
            "name": "Digital Collections Value",
            "expression": "SUM(kpi_digital_collections[digital_collection_value])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "7175ccec-3c0e-4108-a50e-75d2852179fb"
          },
          {
            "name": "Cash Collections Value",
            "expression": "SUM(kpi_digital_collections[cash_collection_value])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "84657e48-a878-4a3c-9b38-07bdf9cbd7a4"
          },
          {
            "name": "UPI Value",
            "expression": "SUM(kpi_digital_collections[upi_value])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "4a6acbfd-99a7-4dea-9fc9-85ab721fccf9"
          },
          {
            "name": "Bank Transfer Value",
            "expression": "SUM(kpi_digital_collections[bank_transfer_value])",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "85a80e3c-0b34-48af-bf80-d50ee5da9d72"
          },
          {
            "name": "Digital Value Share %",
            "expression": "DIVIDE([Digital Collections Value], [Total Collections Value], 0)",
            "formatString": "0.00%",
            "lineageTag": "9f076881-bcf6-423a-a7c3-4e5c7d7cb7d1"
          },
          {
            "name": "Digital Count Share %",
            "expression": "DIVIDE(SUM(kpi_digital_collections[digital_transaction_count]), SUM(kpi_digital_collections[total_transaction_count]), 0)",
            "formatString": "0.00%",
            "lineageTag": "a08019c0-1606-4972-8ddc-9eb4dd846d96"
          },
          {
            "name": "Cumulative Scheduled Due (Vintage)",
            "expression": "SUMX(\n    SUMMARIZE(\n        kpi_vintage_curves,\n        kpi_vintage_curves[cohort_month],\n        kpi_vintage_curves[product_id]\n    ),\n    VAR _CurCohort = kpi_vintage_curves[cohort_month]\n    VAR _CurProduct = kpi_vintage_curves[product_id]\n    VAR _MaxMOB = \n        CALCULATE(\n            MAX(kpi_vintage_curves[month_on_book]),\n            kpi_vintage_curves[cohort_month] = _CurCohort,\n            kpi_vintage_curves[product_id] = _CurProduct\n        )\n    RETURN\n        CALCULATE(\n            SUM(kpi_vintage_curves[cumulative_scheduled_due]),\n            kpi_vintage_curves[cohort_month] = _CurCohort,\n            kpi_vintage_curves[product_id] = _CurProduct,\n            kpi_vintage_curves[month_on_book] = _MaxMOB\n        )\n)",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "866c6f27-e6d1-4a2d-b815-9fded6e087dd"
          },
          {
            "name": "Cumulative Amount Paid (Vintage)",
            "expression": "SUMX(\n    SUMMARIZE(\n        kpi_vintage_curves,\n        kpi_vintage_curves[cohort_month],\n        kpi_vintage_curves[product_id]\n    ),\n    VAR _CurCohort = kpi_vintage_curves[cohort_month]\n    VAR _CurProduct = kpi_vintage_curves[product_id]\n    VAR _MaxMOB = \n        CALCULATE(\n            MAX(kpi_vintage_curves[month_on_book]),\n            kpi_vintage_curves[cohort_month] = _CurCohort,\n            kpi_vintage_curves[product_id] = _CurProduct\n        )\n    RETURN\n        CALCULATE(\n            SUM(kpi_vintage_curves[cumulative_amount_paid]),\n            kpi_vintage_curves[cohort_month] = _CurCohort,\n            kpi_vintage_curves[product_id] = _CurProduct,\n            kpi_vintage_curves[month_on_book] = _MaxMOB\n        )\n)",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "36090f32-396f-402f-a689-00ce945a3d3f"
          },
          {
            "name": "Vintage Repayment Rate %",
            "expression": "DIVIDE([Cumulative Amount Paid (Vintage)], [Cumulative Scheduled Due (Vintage)], 0)",
            "formatString": "0.00%",
            "lineageTag": "58e62431-2ab3-4d07-b9ed-514ad796e9ad"
          },
          {
            "name": "Total Quarantined Records",
            "expression": "COUNTROWS(stg_quarantined_records)",
            "formatString": "#,##0",
            "lineageTag": "25898ab0-b1f3-49e5-b3f2-b0c4cfbbebe9"
          },
          {
            "name": "Negative Amount Anomalies",
            "expression": "CALCULATE(COUNTROWS(stg_quarantined_records), stg_quarantined_records[reason_code] = \"NEGATIVE_PAYMENT_AMOUNT\")",
            "formatString": "#,##0",
            "lineageTag": "4365b21d-cc08-4586-94dd-c5f7bb0c1a18"
          },
          {
            "name": "Pre-dated Payment Anomalies",
            "expression": "CALCULATE(COUNTROWS(stg_quarantined_records), stg_quarantined_records[reason_code] = \"PAYMENT_BEFORE_DISBURSEMENT\")",
            "formatString": "#,##0",
            "lineageTag": "9d39da76-0771-4cf4-a23e-5fba9a079384"
          },
          {
            "name": "Excess Payment Anomalies",
            "expression": "CALCULATE(COUNTROWS(stg_quarantined_records), stg_quarantined_records[reason_code] = \"EXCESS_INSTALMENT_PAYMENT\")",
            "formatString": "#,##0",
            "lineageTag": "e1c73f92-8f0c-434c-9769-b90b24166e58"
          },
          {
            "name": "Loans Disbursed Count",
            "expression": "CALCULATE(DISTINCTCOUNT(dim_loan[loan_key]), USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key]))",
            "formatString": "#,##0",
            "lineageTag": "bcfa6750-91a0-4963-ae08-54803d053fac"
          },
          {
            "name": "Total Disbursed Principal",
            "expression": "CALCULATE(SUM(dim_loan[principal_amount]), USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key]))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "947d9b25-1204-4154-8694-a66cdba3dbd6"
          },
          {
            "name": "Disbursed Principal (INR Cr)",
            "expression": "DIVIDE([Total Disbursed Principal], 10000000, 0)",
            "formatString": "\"\u20b9\"\\ #,##0.00\\ \"Cr\"",
            "lineageTag": "ab208687-ce1d-4065-8a1f-adec0a1f2f24"
          },
          {
            "name": "Payments by Loan Disbursement Date",
            "expression": "CALCULATE(SUM(fact_payment[payment_amount]), USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key]))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "f6c1724f-e1b4-4d36-9476-50a61c06d77a"
          },
          {
            "name": "Allocations by Cash Payment Date",
            "expression": "CALCULATE(SUM(fact_instalment_allocation[allocated_amount]), USERELATIONSHIP(fact_instalment_allocation[payment_date_key], dim_date[date_key]))",
            "formatString": "\"\u20b9\"\\ #,##0.00",
            "lineageTag": "ee2aef55-c099-4041-8d80-669851f9e179"
          },
          {
            "name": "Total Loans Count",
            "description": "Total active and historical loan accounts registered in the portfolio dimension (excluding unknown fallback).",
            "expression": "CALCULATE(DISTINCTCOUNT(dim_loan[loan_id]), dim_loan[loan_key] > 0)",
            "formatString": "#,0",
            "lineageTag": "meas-total-loans-count"
          },
          {
            "name": "Digital Transactions Count",
            "description": "Total volume of digital repayment transactions executed across UPI and net banking rails.",
            "expression": "SUM(kpi_digital_collections[digital_transaction_count])",
            "formatString": "#,0",
            "lineageTag": "meas-dig-trans-count"
          },
          {
            "name": "Average Digital Payment Amount",
            "description": "Average ticket size realized per digital collection transaction.",
            "expression": "DIVIDE([Digital Collections Value], [Digital Transactions Count], 0)",
            "formatString": "\u20b9#,0.00",
            "lineageTag": "meas-avg-dig-payment"
          },
          {
            "name": "Total Raw Records",
            "description": "Total volume of ingestion payloads ingested across all transactional sources.",
            "expression": "[Total Clean Records] + [Total Quarantined Records]",
            "formatString": "#,0",
            "lineageTag": "meas-total-raw-records"
          },
          {
            "name": "Total Clean Records",
            "description": "Total repayment transactions verified, validated, and loaded into warehouse dimensional facts.",
            "expression": "COUNTROWS(fact_payment)",
            "formatString": "#,0",
            "lineageTag": "meas-total-clean-records"
          },
          {
            "name": "Data Quality Pass Rate %",
            "description": "Proportion of raw source records successfully meeting all data quality and domain constraints.",
            "expression": "DIVIDE([Total Clean Records], [Total Raw Records], 0)",
            "formatString": "0.00%",
            "lineageTag": "meas-dq-pass-rate"
          },
          {
            "name": "Issue Categories Count",
            "description": "Number of distinct anomaly reason codes identified by ingestion quarantine rules.",
            "expression": "DISTINCTCOUNT(stg_quarantined_records[reason_code])",
            "formatString": "#,0",
            "lineageTag": "meas-issue-cats-count"
          },
          {
            "name": "Digital Collection MoM Growth %",
            "description": "Month-over-month percentage growth in digital collection value.",
            "expression": "AVERAGE(kpi_digital_collections[mom_digital_value_growth_pct])",
            "formatString": "0.00%",
            "lineageTag": "meas-dig-mom-growth"
          },
          {
            "name": "Digital Collection YoY Growth %",
            "description": "Year-over-year percentage growth in digital collection value.",
            "expression": "AVERAGE(kpi_digital_collections[yoy_digital_value_growth_pct])",
            "formatString": "0.00%",
            "lineageTag": "meas-dig-yoy-growth"
          }
        ],
        "partitions": [
