        "partitions": [
          {
            "name": "dim_date-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    CleanLocation = Text.TrimEnd(Text.Replace(Location, \"\\\\\", \"/\"), {\"/\"}),",
                "    FilePath = CleanLocation & \"/data/powerbi_extracts/dim_date.csv\",",
                "    Source = Csv.Document(File.Contents(FilePath), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])",
                "in",
                "    #\"Promoted Headers\""
              ]
            }
