// ============================================================================
// FINANCIAL INCLUSION ANALYTICS WAREHOUSE — ENTERPRISE DAX MEASURES CATALOGUE
// Standard: Power BI Tabular / DAX Studio Format
// Currency: INR (₹), Lakhs (L), Crores (Cr)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. PORTFOLIO HEALTH & RISK MEASURES (Semi-Additive Snapshot Logic)
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Active Loans Count] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                DISTINCTCOUNT(fact_loan_monthly[loan_key]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[outstanding_principal] > 0,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: #,##0
    // Description: Total count of active loans with positive outstanding principal as of latest selected snapshot

MEASURE '_Measures'[Total Outstanding Principal] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Gross outstanding principal balance across active loans at latest snapshot

MEASURE '_Measures'[Outstanding Principal (INR Cr)] = 
    DIVIDE([Total Outstanding Principal], 10000000, 0)
    // Format: ₹ #,##0.00 "Cr"
    // Description: Gross outstanding principal normalized into Crores

MEASURE '_Measures'[PAR 30 Principal] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] > 30,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Outstanding principal on loans with DPD > 30 days

MEASURE '_Measures'[PAR 30 %] = 
    DIVIDE([PAR 30 Principal], [Total Outstanding Principal], 0)
    // Format: 0.00%
    // Description: Portfolio-at-Risk > 30 days ratio as % of gross principal

MEASURE '_Measures'[PAR 90 Principal] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] > 90,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Outstanding principal on Non-Performing Assets (DPD > 90 days)

MEASURE '_Measures'[PAR 90 %] = 
    DIVIDE([PAR 90 Principal], [Total Outstanding Principal], 0)
    // Format: 0.00%
    // Description: Non-Performing Assets ratio (NPA / PAR90)

MEASURE '_Measures'[Current Principal] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] = 0,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Non-delinquent outstanding principal (0 DPD)

MEASURE '_Measures'[Delinquency DPD 1-30] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] >= 1,
                fact_loan_monthly[days_past_due] <= 30,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Early-stage arrears outstanding principal

MEASURE '_Measures'[Delinquency DPD 31-60] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] >= 31,
                fact_loan_monthly[days_past_due] <= 60,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Sub-standard 31-60 DPD arrears

MEASURE '_Measures'[Delinquency DPD 61-90] = 
    VAR MaxSnapshotDate = 
        CALCULATE(
            MAX(fact_loan_monthly[snapshot_date_key]),
            USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
        )
    RETURN
        IF(
            ISBLANK(MaxSnapshotDate),
            BLANK(),
            CALCULATE(
                SUM(fact_loan_monthly[outstanding_principal]),
                fact_loan_monthly[snapshot_date_key] = MaxSnapshotDate,
                fact_loan_monthly[days_past_due] >= 61,
                fact_loan_monthly[days_past_due] <= 90,
                USERELATIONSHIP(fact_loan_monthly[snapshot_date_key], dim_date[date_key])
            )
        )
    // Format: ₹ #,##0.00
    // Description: Doubtful 61-90 DPD arrears

// ----------------------------------------------------------------------------
// 2. COLLECTION EFFICIENCY & RECOVERY MEASURES
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Scheduled Billing Due] = 
    SUM(kpi_collection_efficiency[scheduled_amount_due])
    // Format: ₹ #,##0.00
    // Description: Total scheduled instalment billing due in reporting period

MEASURE '_Measures'[Current Period Collected] = 
    SUM(kpi_collection_efficiency[current_period_collected])
    // Format: ₹ #,##0.00
    // Description: On-time cash recovered against current month scheduled dues

MEASURE '_Measures'[Arrears Collected] = 
    SUM(kpi_collection_efficiency[arrears_collected])
    // Format: ₹ #,##0.00
    // Description: Arrears cash recovered against prior-period overdue dues

MEASURE '_Measures'[Advance Collected] = 
    SUM(kpi_collection_efficiency[advance_collected])
    // Format: ₹ #,##0.00
    // Description: Advance cash prepayments against future dues

MEASURE '_Measures'[Total Cash Collected] = 
    SUM(kpi_collection_efficiency[total_amount_collected])
    // Format: ₹ #,##0.00
    // Description: Total gross cash receipts (Current + Arrears + Advance)

MEASURE '_Measures'[Current Period Collection Efficiency %] = 
    DIVIDE([Current Period Collected], [Scheduled Billing Due], 0)
    // Format: 0.00%
    // Description: Primary operational headline efficiency (strictly current billing collected / current billing due)

MEASURE '_Measures'[Total Collection Ratio %] = 
    DIVIDE([Total Cash Collected], [Scheduled Billing Due], 0)
    // Format: 0.00%
    // Description: Gross cash recovery ratio against scheduled billing dues

// ----------------------------------------------------------------------------
// 3. DIGITAL COLLECTIONS & TRANSFORMATIONS
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Total Collections Value] = 
    SUM(kpi_digital_collections[total_collection_value])
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Digital Collections Value] = 
    SUM(kpi_digital_collections[digital_collection_value])
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Cash Collections Value] = 
    SUM(kpi_digital_collections[cash_collection_value])
    // Format: ₹ #,##0.00

MEASURE '_Measures'[UPI Value] = 
    SUM(kpi_digital_collections[upi_value])
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Bank Transfer Value] = 
    SUM(kpi_digital_collections[bank_transfer_value])
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Digital Value Share %] = 
    DIVIDE([Digital Collections Value], [Total Collections Value], 0)
    // Format: 0.00%
    // Description: Share of total collection value received digitally (denominator = total collections value)

MEASURE '_Measures'[Digital Count Share %] = 
    DIVIDE(
        SUM(kpi_digital_collections[digital_transaction_count]),
        SUM(kpi_digital_collections[total_transaction_count]),
        0
    )
    // Format: 0.00%
    // Description: Share of total transaction volume processed digitally (denominator = total transaction count)

MEASURE '_Measures'[Avg Ticket Size] = 
    DIVIDE([Total Collections Value], SUM(kpi_digital_collections[total_transaction_count]), 0)
    // Format: ₹ #,##0.00

// ----------------------------------------------------------------------------
// 4. REPAYMENT VINTAGE & MATURITY CURVES
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Cumulative Scheduled Due (Vintage)] = 
    SUMX(
        SUMMARIZE(
            kpi_vintage_curves,
            kpi_vintage_curves[cohort_month],
            kpi_vintage_curves[product_id]
        ),
        VAR _CurCohort = kpi_vintage_curves[cohort_month]
        VAR _CurProduct = kpi_vintage_curves[product_id]
        VAR _MaxMOB = 
            CALCULATE(
                MAX(kpi_vintage_curves[month_on_book]),
                kpi_vintage_curves[cohort_month] = _CurCohort,
                kpi_vintage_curves[product_id] = _CurProduct
            )
        RETURN
            CALCULATE(
                SUM(kpi_vintage_curves[cumulative_scheduled_due]),
                kpi_vintage_curves[cohort_month] = _CurCohort,
                kpi_vintage_curves[product_id] = _CurProduct,
                kpi_vintage_curves[month_on_book] = _MaxMOB
            )
    )
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Cumulative Amount Paid (Vintage)] = 
    SUMX(
        SUMMARIZE(
            kpi_vintage_curves,
            kpi_vintage_curves[cohort_month],
            kpi_vintage_curves[product_id]
        ),
        VAR _CurCohort = kpi_vintage_curves[cohort_month]
        VAR _CurProduct = kpi_vintage_curves[product_id]
        VAR _MaxMOB = 
            CALCULATE(
                MAX(kpi_vintage_curves[month_on_book]),
                kpi_vintage_curves[cohort_month] = _CurCohort,
                kpi_vintage_curves[product_id] = _CurProduct
            )
        RETURN
            CALCULATE(
                SUM(kpi_vintage_curves[cumulative_amount_paid]),
                kpi_vintage_curves[cohort_month] = _CurCohort,
                kpi_vintage_curves[product_id] = _CurProduct,
                kpi_vintage_curves[month_on_book] = _MaxMOB
            )
    )
    // Format: ₹ #,##0.00

MEASURE '_Measures'[Vintage Repayment Rate %] = 
    DIVIDE([Cumulative Amount Paid (Vintage)], [Cumulative Scheduled Due (Vintage)], 0)
    // Format: 0.00%
    // Description: Cumulative cash recovery percentage at Month on Book (MOB) k

// ----------------------------------------------------------------------------
// 5. DATA QUALITY & QUARANTINE FIREWALL
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Total Quarantined Records] = 
    COUNTROWS(stg_quarantined_records)
    // Format: #,##0
    // Description: Total anomalous records isolated by staging quality rules

MEASURE '_Measures'[Negative Amount Anomalies] = 
    CALCULATE(
        COUNTROWS(stg_quarantined_records),
        stg_quarantined_records[reason_code] = "NEGATIVE_PAYMENT_AMOUNT"
    )
    // Format: #,##0

MEASURE '_Measures'[Pre-dated Payment Anomalies] = 
    CALCULATE(
        COUNTROWS(stg_quarantined_records),
        stg_quarantined_records[reason_code] = "PAYMENT_BEFORE_DISBURSEMENT"
    )
    // Format: #,##0

MEASURE '_Measures'[Excess Payment Anomalies] = 
    CALCULATE(
        COUNTROWS(stg_quarantined_records),
        stg_quarantined_records[reason_code] = "EXCESS_INSTALMENT_PAYMENT"
    )
    // Format: #,##0


// ----------------------------------------------------------------------------
// 6. ROLE-PLAYING DATE MEASURES (Using USERELATIONSHIP for Inactive Paths)
// ----------------------------------------------------------------------------

MEASURE '_Measures'[Loans Disbursed Count] = 
    CALCULATE(
        DISTINCTCOUNT(dim_loan[loan_key]),
        USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key])
    )
    // Format: #,##0
    // Description: Count of loans disbursed in the selected calendar period (activates inactive disbursement date path)

MEASURE '_Measures'[Total Disbursed Principal] = 
    CALCULATE(
        SUM(dim_loan[principal_amount]),
        USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key])
    )
    // Format: ₹ #,##0.00
    // Description: Total principal amount disbursed in the selected period (activates inactive disbursement date path)

MEASURE '_Measures'[Disbursed Principal (INR Cr)] = 
    DIVIDE([Total Disbursed Principal], 10000000, 0)
    // Format: ₹ #,##0.00 "Cr"
    // Description: Total principal disbursed normalized into Crores

MEASURE '_Measures'[Payments by Loan Disbursement Date] = 
    CALCULATE(
        SUM(fact_payment[payment_amount]),
        USERELATIONSHIP(dim_loan[disbursement_date_key], dim_date[date_key])
    )
    // Format: ₹ #,##0.00
    // Description: Repayment cash received for loans originated in the selected period

MEASURE '_Measures'[Allocations by Cash Payment Date] = 
    CALCULATE(
        SUM(fact_instalment_allocation[allocated_amount]),
        USERELATIONSHIP(fact_instalment_allocation[payment_date_key], dim_date[date_key])
    )
    // Format: ₹ #,##0.00
    // Description: Instalment allocation cash evaluated on payment receipt date (vs contractual due date)

// ============================================================================
// 10. RECRUITMENT PHASE 2 — DASHBOARD KPI MEASURES (9 MEASURES)
// ============================================================================

MEASURE '_Measures'[Total Loans Count] = 
    CALCULATE(
        DISTINCTCOUNT(dim_loan[loan_id]),
        dim_loan[loan_key] > 0
    )
    // Format: #,##0
    // Description: Total loan contracts registered across the warehouse (excluding unknown fallback)

MEASURE '_Measures'[Digital Transactions Count] = 
    SUM(kpi_digital_collections[digital_transaction_count])
    // Format: #,##0
    // Description: Total volume of digital collection transactions (UPI + Net Banking)

MEASURE '_Measures'[Average Digital Payment Amount] = 
    DIVIDE([Digital Collections Value], [Digital Transactions Count], 0)
    // Format: ₹ #,##0.00
    // Description: Average ticket size realized per digital collection transaction

MEASURE '_Measures'[Total Clean Records] = 
    COUNTROWS(fact_payment)
    // Format: #,##0
    // Description: Total verified transactions successfully loaded into dimensional facts

MEASURE '_Measures'[Total Raw Records] = 
    [Total Clean Records] + [Total Quarantined Records]
    // Format: #,##0
    // Description: Total raw ingestion payloads processed through the ingestion firewall

MEASURE '_Measures'[Data Quality Pass Rate %] = 
    DIVIDE([Total Clean Records], [Total Raw Records], 0)
    // Format: 0.00%
    // Description: Proportion of raw ingestion records meeting all validation checks

MEASURE '_Measures'[Issue Categories Count] = 
    DISTINCTCOUNT(stg_quarantined_records[reason_code])
    // Format: #,##0
    // Description: Distinct anomaly classification categories detected by the quarantine pipeline

MEASURE '_Measures'[Digital Collection MoM Growth %] = 
    AVERAGE(kpi_digital_collections[mom_digital_value_growth_pct])
    // Format: 0.00%
    // Description: Month-over-month average percentage growth in digital collection value

MEASURE '_Measures'[Digital Collection YoY Growth %] = 
    AVERAGE(kpi_digital_collections[yoy_digital_value_growth_pct])
    // Format: 0.00%
    // Description: Year-over-year average percentage growth in digital collection value
