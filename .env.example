# Google Cloud BigQuery Configuration (Optional for Cloud Execution)
# Leave unset or empty to use the zero-cost local BigQuery execution engine.

GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account_credentials.json

# BigQuery Dataset Names (Default standard naming)
BIGQUERY_DATASET_RAW=fin_raw
BIGQUERY_DATASET_STAGING=fin_staging
BIGQUERY_DATASET_WAREHOUSE=fin_warehouse
BIGQUERY_DATASET_ANALYTICS=fin_analytics
BIGQUERY_LOCATION=US
